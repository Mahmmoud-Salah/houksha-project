VITE_MOYASAR_PUBLISHABLE_KEY=pk_test_...

# Optional — only needed to enable Samsung Pay. Get service_id from Samsung Partner
# Portal via the Moyasar Dashboard (Settings > Samsung Pay). Leave unset to hide
# Samsung Pay and keep Apple Pay / credit card only.
VITE_SAMSUNG_PAY_SERVICE_ID=
VITE_SAMSUNG_PAY_ENVIRONMENT=STAGE
